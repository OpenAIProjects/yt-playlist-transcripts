{
  "video_id": "oE4npbB597U",
  "source": "manual",
  "language_code": "zh-Hans",
  "rolling_dedup_applied": false,
  "segments": [
    {
      "start_sec": 0,
      "end_sec": 3,
      "text": "阿尔伯塔省的公投结果出来了"
    },
    {
      "start_sec": 3,
      "end_sec": 4,
      "text": "阿尔伯塔人"
    },
    {
      "start_sec": 4,
      "end_sec": 6,
      "text": "是选择留在加拿大"
    },
    {
      "start_sec": 6,
      "end_sec": 9,
      "text": "公投中最引人注目的第十题"
    },
    {
      "start_sec": 9,
      "end_sec": 12,
      "text": "选择留在加拿大的人大概有76%"
    },
    {
      "start_sec": 12,
      "end_sec": 14,
      "text": "而选择启动独立程序的人"
    },
    {
      "start_sec": 14,
      "end_sec": 16,
      "text": "大概是24%"
    },
    {
      "start_sec": 16,
      "end_sec": 17,
      "text": "也就是说"
    },
    {
      "start_sec": 17,
      "end_sec": 19,
      "text": "4个人里有3个人说不走"
    },
    {
      "start_sec": 20,
      "end_sec": 21,
      "text": "这次投票前"
    },
    {
      "start_sec": 21,
      "end_sec": 22,
      "text": "独立派有个领头的"
    },
    {
      "start_sec": 22,
      "end_sec": 24,
      "text": "叫做西尔维斯特"
    },
    {
      "start_sec": 24,
      "end_sec": 25,
      "text": "他说过"
    },
    {
      "start_sec": 25,
      "end_sec": 26,
      "text": "只要独立这边"
    },
    {
      "start_sec": 26,
      "end_sec": 28,
      "text": "能够超过40%"
    },
    {
      "start_sec": 28,
      "end_sec": 29,
      "text": "这事就有戏"
    },
    {
      "start_sec": 30,
      "end_sec": 32,
      "text": "结果连1/4都不到"
    },
    {
      "start_sec": 33,
      "end_sec": 34,
      "text": "十九号晚上"
    },
    {
      "start_sec": 34,
      "end_sec": 35,
      "text": "两边都在等待结果"
    },
    {
      "start_sec": 35,
      "end_sec": 37,
      "text": "那么数字一个一个地蹦出来"
    },
    {
      "start_sec": 37,
      "end_sec": 38,
      "text": "独立派那边"
    },
    {
      "start_sec": 38,
      "end_sec": 40,
      "text": "是越来越安静"
    },
    {
      "start_sec": 40,
      "end_sec": 42,
      "text": "而支持留下这边"
    },
    {
      "start_sec": 42,
      "end_sec": 44,
      "text": "在埃德蒙顿一个叫做波兰会馆的地方"
    },
    {
      "start_sec": 44,
      "end_sec": 46,
      "text": "是挤满了人"
    },
    {
      "start_sec": 46,
      "end_sec": 46,
      "text": "带头的人"
    },
    {
      "start_sec": 46,
      "end_sec": 48,
      "text": "叫做卢卡斯祖克"
    },
    {
      "start_sec": 48,
      "end_sec": 50,
      "text": "他手里是拿着个牛铃"
    },
    {
      "start_sec": 50,
      "end_sec": 52,
      "text": "一边等一边敲"
    },
    {
      "start_sec": 52,
      "end_sec": 53,
      "text": "到了半夜"
    },
    {
      "start_sec": 53,
      "end_sec": 55,
      "text": "结果差不多定下来了"
    },
    {
      "start_sec": 55,
      "end_sec": 57,
      "text": "他喊出了一句震耳欲聋的口号"
    },
    {
      "start_sec": 58,
      "end_sec": 59,
      "text": "别惹加拿大"
    },
    {
      "start_sec": 59,
      "end_sec": 61,
      "text": "台底下是一片的叫好"
    },
    {
      "start_sec": 62,
      "end_sec": 64,
      "text": "我们在上期的视频中已经详细"
    },
    {
      "start_sec": 64,
      "end_sec": 66,
      "text": "地说过了为什么要办这次公投"
    },
    {
      "start_sec": 66,
      "end_sec": 68,
      "text": "以及那10道题都问了什么"
    },
    {
      "start_sec": 68,
      "end_sec": 70,
      "text": "咱们今天就不重复了"
    },
    {
      "start_sec": 70,
      "end_sec": 73,
      "text": "今天咱们就来聊两件事情"
    },
    {
      "start_sec": 73,
      "end_sec": 75,
      "text": "一件事情是投票这一天"
    },
    {
      "start_sec": 75,
      "end_sec": 76,
      "text": "到底发生了什么"
    },
    {
      "start_sec": 76,
      "end_sec": 79,
      "text": "第二是这个结果背后代表了"
    },
    {
      "start_sec": 79,
      "end_sec": 81,
      "text": "阿省人民什么样的想法"
    },
    {
      "start_sec": 81,
      "end_sec": 82,
      "text": "先说投票这一天"
    },
    {
      "start_sec": 82,
      "end_sec": 84,
      "text": "这次阿省选举局"
    },
    {
      "start_sec": 84,
      "end_sec": 87,
      "text": "一共是印了4,500万张选票"
    },
    {
      "start_sec": 87,
      "end_sec": 88,
      "text": "为什么这么多"
    },
    {
      "start_sec": 88,
      "end_sec": 89,
      "text": "因为10道题"
    },
    {
      "start_sec": 89,
      "end_sec": 91,
      "text": "每道题都是单独的一张"
    },
    {
      "start_sec": 91,
      "end_sec": 93,
      "text": "选举局的发言人都说"
    },
    {
      "start_sec": 93,
      "end_sec": 94,
      "text": "这么大的阵仗"
    },
    {
      "start_sec": 94,
      "end_sec": 96,
      "text": "以前从来没有见过"
    },
    {
      "start_sec": 96,
      "end_sec": 97,
      "text": "来投票的人"
    },
    {
      "start_sec": 97,
      "end_sec": 98,
      "text": "也是真多"
    },
    {
      "start_sec": 98,
      "end_sec": 101,
      "text": "光是提前投票和邮寄投票"
    },
    {
      "start_sec": 101,
      "end_sec": 103,
      "text": "就有135万人"
    },
    {
      "start_sec": 103,
      "end_sec": 106,
      "text": "而到了周一正式投票日的早晨"
    },
    {
      "start_sec": 106,
      "end_sec": 108,
      "text": "第十题就已经数出了"
    },
    {
      "start_sec": 108,
      "end_sec": 110,
      "text": "220多万张有效的选票"
    },
    {
      "start_sec": 111,
      "end_sec": 114,
      "text": "全省一共才315万左右的选民"
    },
    {
      "start_sec": 114,
      "end_sec": 115,
      "text": "那么这么一算"
    },
    {
      "start_sec": 115,
      "end_sec": 116,
      "text": "投票率"
    },
    {
      "start_sec": 116,
      "end_sec": 118,
      "text": "至少是要在7成左右"
    },
    {
      "start_sec": 118,
      "end_sec": 121,
      "text": "2021年阿省也搞过一次公投"
    },
    {
      "start_sec": 121,
      "end_sec": 121,
      "text": "那么投的"
    },
    {
      "start_sec": 121,
      "end_sec": 123,
      "text": "是均衡支付"
    },
    {
      "start_sec": 123,
      "end_sec": 126,
      "text": "那次的投票率才只有39%"
    },
    {
      "start_sec": 126,
      "end_sec": 127,
      "text": "人一多"
    },
    {
      "start_sec": 127,
      "end_sec": 128,
      "text": "就出了状况"
    },
    {
      "start_sec": 128,
      "end_sec": 129,
      "text": "在投票那一天"
    },
    {
      "start_sec": 129,
      "end_sec": 132,
      "text": "全省有106个投票站"
    },
    {
      "start_sec": 132,
      "end_sec": 133,
      "text": "没有按时开门"
    },
    {
      "start_sec": 133,
      "end_sec": 135,
      "text": "这里面什么原因都有"
    },
    {
      "start_sec": 135,
      "end_sec": 137,
      "text": "有的是工作人员请病假"
    },
    {
      "start_sec": 137,
      "end_sec": 138,
      "text": "也有迟到的"
    },
    {
      "start_sec": 138,
      "end_sec": 139,
      "text": "有电脑出毛病的"
    },
    {
      "start_sec": 139,
      "end_sec": 141,
      "text": "还有东西没摆好的"
    },
    {
      "start_sec": 141,
      "end_sec": 143,
      "text": "那么这些开门晚的投票站"
    },
    {
      "start_sec": 143,
      "end_sec": 146,
      "text": "就只能是拖到晚上10点才关门"
    },
    {
      "start_sec": 146,
      "end_sec": 148,
      "text": "选举局有个规定"
    },
    {
      "start_sec": 148,
      "end_sec": 149,
      "text": "最后一个站没关门"
    },
    {
      "start_sec": 149,
      "end_sec": 152,
      "text": "一个结果都不能往外公布"
    },
    {
      "start_sec": 152,
      "end_sec": 153,
      "text": "这么一来"
    },
    {
      "start_sec": 153,
      "end_sec": 155,
      "text": "整个计票就往后拖了好几个钟头"
    },
    {
      "start_sec": 156,
      "end_sec": 158,
      "text": "当然这里面也有好玩的事"
    },
    {
      "start_sec": 158,
      "end_sec": 160,
      "text": "埃德蒙顿有家冰淇淋店"
    },
    {
      "start_sec": 160,
      "end_sec": 161,
      "text": "是搞活动"
    },
    {
      "start_sec": 161,
      "end_sec": 163,
      "text": "你在投票站门口拍张自拍"
    },
    {
      "start_sec": 163,
      "end_sec": 166,
      "text": "就送小孩子一个冰淇淋球"
    },
    {
      "start_sec": 166,
      "end_sec": 168,
      "text": "卡尔加里的皇家山大学"
    },
    {
      "start_sec": 168,
      "end_sec": 169,
      "text": "有位教授干脆是给"
    },
    {
      "start_sec": 169,
      "end_sec": 170,
      "text": "学生放了一天的假"
    },
    {
      "start_sec": 170,
      "end_sec": 172,
      "text": "让大家都去投票"
    },
    {
      "start_sec": 172,
      "end_sec": 173,
      "text": "有个学生说"
    },
    {
      "start_sec": 173,
      "end_sec": 174,
      "text": "今年早些时候"
    },
    {
      "start_sec": 174,
      "end_sec": 177,
      "text": "班上很多同学还拿这次公投开玩笑"
    },
    {
      "start_sec": 177,
      "end_sec": 179,
      "text": "可是到了投票这一天"
    },
    {
      "start_sec": 179,
      "end_sec": 180,
      "text": "大家都当回事了"
    },
    {
      "start_sec": 181,
      "end_sec": 182,
      "text": "卡尔加里还有一个选民"
    },
    {
      "start_sec": 182,
      "end_sec": 184,
      "text": "叫做斯科特·希尔"
    },
    {
      "start_sec": 184,
      "end_sec": 186,
      "text": "他戴着一顶枫叶的帽子去投票"
    },
    {
      "start_sec": 187,
      "end_sec": 188,
      "text": "他爷爷打过二战"
    },
    {
      "start_sec": 188,
      "end_sec": 190,
      "text": "他说毫无疑问"
    },
    {
      "start_sec": 190,
      "end_sec": 193,
      "text": "这是我这辈子投过的最重要的一票"
    },
    {
      "start_sec": 193,
      "end_sec": 194,
      "text": "还有一对老夫妻"
    },
    {
      "start_sec": 194,
      "end_sec": 196,
      "text": "叫做加里和伊芙琳"
    },
    {
      "start_sec": 196,
      "end_sec": 198,
      "text": "是从魁北克搬来的"
    },
    {
      "start_sec": 198,
      "end_sec": 201,
      "text": "1995年魁北克那次搞独立公投"
    },
    {
      "start_sec": 201,
      "end_sec": 203,
      "text": "他们俩投的是留在加拿大"
    },
    {
      "start_sec": 204,
      "end_sec": 205,
      "text": "30年过去了"
    },
    {
      "start_sec": 205,
      "end_sec": 207,
      "text": "他们也搬到了阿尔伯塔省"
    },
    {
      "start_sec": 207,
      "end_sec": 208,
      "text": "可是这回"
    },
    {
      "start_sec": 208,
      "end_sec": 210,
      "text": "他们是反倒支持独立"
    },
    {
      "start_sec": 210,
      "end_sec": 211,
      "text": "加里说"
    },
    {
      "start_sec": 211,
      "end_sec": 214,
      "text": "阿省的财政自己养活自己没问题"
    },
    {
      "start_sec": 214,
      "end_sec": 215,
      "text": "一对夫妻"
    },
    {
      "start_sec": 215,
      "end_sec": 216,
      "text": "两次公投"
    },
    {
      "start_sec": 216,
      "end_sec": 219,
      "text": "但是选的却是正好相反"
    },
    {
      "start_sec": 220,
      "end_sec": 222,
      "text": "这次投票还有一群人的声音"
    },
    {
      "start_sec": 222,
      "end_sec": 223,
      "text": "不太容易被人听到"
    },
    {
      "start_sec": 223,
      "end_sec": 225,
      "text": "就是原住民"
    },
    {
      "start_sec": 225,
      "end_sec": 226,
      "text": "上期我们讲过"
    },
    {
      "start_sec": 226,
      "end_sec": 228,
      "text": "独立派当初的请愿"
    },
    {
      "start_sec": 228,
      "end_sec": 230,
      "text": "就是因为没跟原住民协商"
    },
    {
      "start_sec": 230,
      "end_sec": 232,
      "text": "被法院最终给叫停了"
    },
    {
      "start_sec": 232,
      "end_sec": 233,
      "text": "而这一次"
    },
    {
      "start_sec": 233,
      "end_sec": 235,
      "text": "原住民社区去投票的人"
    },
    {
      "start_sec": 235,
      "end_sec": 237,
      "text": "也比预想的要多"
    },
    {
      "start_sec": 237,
      "end_sec": 239,
      "text": "选举局只好临时找快递"
    },
    {
      "start_sec": 239,
      "end_sec": 242,
      "text": "往一些保留地多的地方送选票"
    },
    {
      "start_sec": 243,
      "end_sec": 245,
      "text": "那么有一位克里族的酋长说"
    },
    {
      "start_sec": 245,
      "end_sec": 246,
      "text": "搞这次公投"
    },
    {
      "start_sec": 246,
      "end_sec": 247,
      "text": "纯属是胡闹"
    },
    {
      "start_sec": 247,
      "end_sec": 249,
      "text": "而另外一位酋长说"
    },
    {
      "start_sec": 249,
      "end_sec": 251,
      "text": "这就是在转移视线"
    },
    {
      "start_sec": 251,
      "end_sec": 253,
      "text": "分离根本就是无稽之谈"
    },
    {
      "start_sec": 254,
      "end_sec": 256,
      "text": "咱们再来说说结果背后的民意"
    },
    {
      "start_sec": 256,
      "end_sec": 258,
      "text": "76%这个数字"
    },
    {
      "start_sec": 258,
      "end_sec": 261,
      "text": "比投票前大部分的民调都要高"
    },
    {
      "start_sec": 261,
      "end_sec": 265,
      "text": "益普索9月份做的民调是70:20"
    },
    {
      "start_sec": 265,
      "end_sec": 268,
      "text": "Abacus Data的民调是64:24"
    },
    {
      "start_sec": 268,
      "end_sec": 269,
      "text": "所以阿省人对这个"
    },
    {
      "start_sec": 269,
      "end_sec": 271,
      "text": "问题的最终投票结果"
    },
    {
      "start_sec": 271,
      "end_sec": 273,
      "text": "意思已经很明白了"
    },
    {
      "start_sec": 273,
      "end_sec": 274,
      "text": "我们不走"
    },
    {
      "start_sec": 274,
      "end_sec": 276,
      "text": "我们再来看那24%"
    },
    {
      "start_sec": 276,
      "end_sec": 278,
      "text": "选择启动独立程序的人"
    },
    {
      "start_sec": 278,
      "end_sec": 280,
      "text": "他们也有好几十万人"
    },
    {
      "start_sec": 280,
      "end_sec": 282,
      "text": "不过这里面也有不少人"
    },
    {
      "start_sec": 282,
      "end_sec": 284,
      "text": "其实并不是真的想走"
    },
    {
      "start_sec": 284,
      "end_sec": 286,
      "text": "投票前就有一个调查"
    },
    {
      "start_sec": 286,
      "end_sec": 289,
      "text": "说打算投独立的人里面"
    },
    {
      "start_sec": 289,
      "end_sec": 292,
      "text": "差不多2/3就是想借这一票"
    },
    {
      "start_sec": 292,
      "end_sec": 294,
      "text": "让渥太华听到他们的声音"
    },
    {
      "start_sec": 294,
      "end_sec": 296,
      "text": "咱们再来看地图"
    },
    {
      "start_sec": 296,
      "end_sec": 298,
      "text": "城里和乡下的民意"
    },
    {
      "start_sec": 298,
      "end_sec": 299,
      "text": "也是差得很远"
    },
    {
      "start_sec": 299,
      "end_sec": 301,
      "text": "卡尔加里的选区"
    },
    {
      "start_sec": 301,
      "end_sec": 304,
      "text": "留下来的票大概是在8成到9成"
    },
    {
      "start_sec": 304,
      "end_sec": 305,
      "text": "卡尔加里东北"
    },
    {
      "start_sec": 305,
      "end_sec": 306,
      "text": "新移民多"
    },
    {
      "start_sec": 306,
      "end_sec": 307,
      "text": "留下的人"
    },
    {
      "start_sec": 307,
      "end_sec": 309,
      "text": "占比达到了接近9成"
    },
    {
      "start_sec": 309,
      "end_sec": 311,
      "text": "而独立票高的"
    },
    {
      "start_sec": 311,
      "end_sec": 313,
      "text": "都是在北边和东南边的农村"
    },
    {
      "start_sec": 313,
      "end_sec": 314,
      "text": "到现在为止"
    },
    {
      "start_sec": 314,
      "end_sec": 316,
      "text": "全省87个选区"
    },
    {
      "start_sec": 316,
      "end_sec": 318,
      "text": "只有一个选区"
    },
    {
      "start_sec": 318,
      "end_sec": 320,
      "text": "那么选独立的过了一半"
    },
    {
      "start_sec": 320,
      "end_sec": 322,
      "text": "也就是51.1%"
    },
    {
      "start_sec": 322,
      "end_sec": 322,
      "text": "这个选区"
    },
    {
      "start_sec": 322,
      "end_sec": 325,
      "text": "在埃德蒙顿西北500公里左右"
    },
    {
      "start_sec": 325,
      "end_sec": 327,
      "text": "是一个典型的农业地区"
    },
    {
      "start_sec": 328,
      "end_sec": 330,
      "text": "咱们再来看前面那9道题"
    },
    {
      "start_sec": 330,
      "end_sec": 331,
      "text": "这就没有那么简单了"
    },
    {
      "start_sec": 332,
      "end_sec": 333,
      "text": "移民那5道题"
    },
    {
      "start_sec": 333,
      "end_sec": 336,
      "text": "到现在都是赞成的多"
    },
    {
      "start_sec": 336,
      "end_sec": 339,
      "text": "大概是在57%到62%左右"
    },
    {
      "start_sec": 339,
      "end_sec": 340,
      "text": "你比如说向临时居民"
    },
    {
      "start_sec": 340,
      "end_sec": 342,
      "text": "收取医疗和教育的费用"
    },
    {
      "start_sec": 342,
      "end_sec": 345,
      "text": "这条赞成的是57%左右"
    },
    {
      "start_sec": 345,
      "end_sec": 348,
      "text": "而投票的时候要拿公民身份证明"
    },
    {
      "start_sec": 348,
      "end_sec": 349,
      "text": "那么这一条"
    },
    {
      "start_sec": 349,
      "end_sec": 352,
      "text": "赞成的最多是达到了六成可是"
    },
    {
      "start_sec": 352,
      "end_sec": 355,
      "text": "这些比例都比投票前的民调要低"
    },
    {
      "start_sec": 355,
      "end_sec": 356,
      "text": "今年3月"
    },
    {
      "start_sec": 356,
      "end_sec": 357,
      "text": "Léger的一份民调"
    },
    {
      "start_sec": 357,
      "end_sec": 361,
      "text": "这几道题都在63%到66%左右"
    },
    {
      "start_sec": 361,
      "end_sec": 362,
      "text": "也就是说"
    },
    {
      "start_sec": 362,
      "end_sec": 364,
      "text": "到了真正投票的时候"
    },
    {
      "start_sec": 364,
      "end_sec": 365,
      "text": "有些人还是犹豫了"
    },
    {
      "start_sec": 366,
      "end_sec": 367,
      "text": "在卡尔加里"
    },
    {
      "start_sec": 367,
      "end_sec": 368,
      "text": "记者问了两个选民"
    },
    {
      "start_sec": 368,
      "end_sec": 370,
      "text": "一个叫做杰米·费舍尔"
    },
    {
      "start_sec": 370,
      "end_sec": 371,
      "text": "那9道题"
    },
    {
      "start_sec": 371,
      "end_sec": 372,
      "text": "他全都投了赞成"
    },
    {
      "start_sec": 373,
      "end_sec": 373,
      "text": "而另外一个"
    },
    {
      "start_sec": 373,
      "end_sec": 375,
      "text": "叫做阿姆尼特·曼"
    },
    {
      "start_sec": 375,
      "end_sec": 377,
      "text": "他说移民那几道题"
    },
    {
      "start_sec": 377,
      "end_sec": 378,
      "text": "就是冲着移民来的"
    },
    {
      "start_sec": 378,
      "end_sec": 380,
      "text": "加拿大不应该是这样"
    },
    {
      "start_sec": 380,
      "end_sec": 382,
      "text": "埃德蒙顿的市长纳克也说了"
    },
    {
      "start_sec": 382,
      "end_sec": 385,
      "text": "9道题他全投了反对"
    },
    {
      "start_sec": 385,
      "end_sec": 386,
      "text": "他说"
    },
    {
      "start_sec": 386,
      "end_sec": 389,
      "text": "他不想让移民觉得这里不欢迎他们"
    },
    {
      "start_sec": 389,
      "end_sec": 391,
      "text": "而修宪那四道题"
    },
    {
      "start_sec": 391,
      "end_sec": 392,
      "text": "更是一半对一半"
    },
    {
      "start_sec": 393,
      "end_sec": 394,
      "text": "省里自己挑法官"
    },
    {
      "start_sec": 394,
      "end_sec": 396,
      "text": "省里的法律自己说了算"
    },
    {
      "start_sec": 396,
      "end_sec": 397,
      "text": "这两道题"
    },
    {
      "start_sec": 397,
      "end_sec": 399,
      "text": "两边一直是咬得很紧"
    },
    {
      "start_sec": 399,
      "end_sec": 400,
      "text": "还有第八题"
    },
    {
      "start_sec": 400,
      "end_sec": 402,
      "text": "说不参与联邦的项目"
    },
    {
      "start_sec": 402,
      "end_sec": 403,
      "text": "但是钱照拿"
    },
    {
      "start_sec": 403,
      "end_sec": 405,
      "text": "这道题到凌晨的时候"
    },
    {
      "start_sec": 405,
      "end_sec": 407,
      "text": "两边一度只差75票"
    },
    {
      "start_sec": 407,
      "end_sec": 408,
      "text": "到了早上"
    },
    {
      "start_sec": 408,
      "end_sec": 410,
      "text": "反对的又稍微多了一点"
    },
    {
      "start_sec": 410,
      "end_sec": 411,
      "text": "那么这几道题"
    },
    {
      "start_sec": 411,
      "end_sec": 412,
      "text": "数得最晚"
    },
    {
      "start_sec": 412,
      "end_sec": 413,
      "text": "到底谁赢"
    },
    {
      "start_sec": 413,
      "end_sec": 415,
      "text": "最后还要等到"
    },
    {
      "start_sec": 415,
      "end_sec": 417,
      "text": "星期三最终的结果出来"
    },
    {
      "start_sec": 417,
      "end_sec": 420,
      "text": "但是即使现在没有最精确的数字"
    },
    {
      "start_sec": 420,
      "end_sec": 422,
      "text": "我们已经能够大概看出"
    },
    {
      "start_sec": 422,
      "end_sec": 424,
      "text": "阿省人民的真实想法了"
    },
    {
      "start_sec": 424,
      "end_sec": 425,
      "text": "移民这一块"
    },
    {
      "start_sec": 425,
      "end_sec": 427,
      "text": "阿省人民还是更趋于保守"
    },
    {
      "start_sec": 427,
      "end_sec": 429,
      "text": "大概6成左右的人"
    },
    {
      "start_sec": 429,
      "end_sec": 431,
      "text": "想要管得更紧一点"
    },
    {
      "start_sec": 431,
      "end_sec": 433,
      "text": "可是一说到跟渥太华对着干"
    },
    {
      "start_sec": 433,
      "end_sec": 435,
      "text": "改宪法争权力"
    },
    {
      "start_sec": 435,
      "end_sec": 436,
      "text": "两边的意见"
    },
    {
      "start_sec": 436,
      "end_sec": 438,
      "text": "仍是不相上下"
    },
    {
      "start_sec": 438,
      "end_sec": 439,
      "text": "至于离开加拿大"
    },
    {
      "start_sec": 439,
      "end_sec": 440,
      "text": "这个最关键的问题"
    },
    {
      "start_sec": 440,
      "end_sec": 442,
      "text": "有3/4的人说不"
    },
    {
      "start_sec": 442,
      "end_sec": 443,
      "text": "结果出来以后"
    },
    {
      "start_sec": 443,
      "end_sec": 445,
      "text": "我们再来看各方面的表态"
    },
    {
      "start_sec": 445,
      "end_sec": 446,
      "text": "先说省长史密斯"
    },
    {
      "start_sec": 447,
      "end_sec": 448,
      "text": "她投票前"
    },
    {
      "start_sec": 448,
      "end_sec": 449,
      "text": "就把话说在了前头"
    },
    {
      "start_sec": 449,
      "end_sec": 452,
      "text": "她说办这次公投就是要把独立"
    },
    {
      "start_sec": 452,
      "end_sec": 454,
      "text": "这件事情一次性说清楚"
    },
    {
      "start_sec": 454,
      "end_sec": 457,
      "text": "只要投票结果跟民调差不多"
    },
    {
      "start_sec": 457,
      "end_sec": 458,
      "text": "大家就应该接受"
    },
    {
      "start_sec": 458,
      "end_sec": 459,
      "text": "然后往前走"
    },
    {
      "start_sec": 460,
      "end_sec": 461,
      "text": "而且她这一任任期里"
    },
    {
      "start_sec": 461,
      "end_sec": 464,
      "text": "不会再搞第二次独立公投"
    },
    {
      "start_sec": 464,
      "end_sec": 465,
      "text": "不过她之前也说了"
    },
    {
      "start_sec": 465,
      "end_sec": 467,
      "text": "另外那9道题"
    },
    {
      "start_sec": 467,
      "end_sec": 469,
      "text": "她是希望大家都投赞成"
    },
    {
      "start_sec": 469,
      "end_sec": 470,
      "text": "有了这个授权"
    },
    {
      "start_sec": 470,
      "end_sec": 472,
      "text": "她才好去跟卡尼谈"
    },
    {
      "start_sec": 472,
      "end_sec": 474,
      "text": "给阿省争取一个更好的条件"
    },
    {
      "start_sec": 475,
      "end_sec": 476,
      "text": "但是现在结果出来了"
    },
    {
      "start_sec": 476,
      "end_sec": 477,
      "text": "移民那几道题"
    },
    {
      "start_sec": 477,
      "end_sec": 479,
      "text": "都是微弱的优势过了"
    },
    {
      "start_sec": 479,
      "end_sec": 481,
      "text": "可修宪那几道题"
    },
    {
      "start_sec": 481,
      "end_sec": 483,
      "text": "基本都是一半对一半"
    },
    {
      "start_sec": 483,
      "end_sec": 486,
      "text": "她原本想拿着一副好牌去渥太华"
    },
    {
      "start_sec": 486,
      "end_sec": 487,
      "text": "可是现在手里这副牌"
    },
    {
      "start_sec": 487,
      "end_sec": 490,
      "text": "也远没有她想的那么好"
    },
    {
      "start_sec": 490,
      "end_sec": 492,
      "text": "咱们再来看总理卡尼"
    },
    {
      "start_sec": 492,
      "end_sec": 494,
      "text": "卡尼是在埃德蒙顿长大的"
    },
    {
      "start_sec": 494,
      "end_sec": 496,
      "text": "这次公投他也是真上心了"
    },
    {
      "start_sec": 497,
      "end_sec": 498,
      "text": "投票前的周五周六"
    },
    {
      "start_sec": 498,
      "end_sec": 500,
      "text": "他专门是跑到阿省"
    },
    {
      "start_sec": 500,
      "end_sec": 502,
      "text": "连着两天到处拉票"
    },
    {
      "start_sec": 502,
      "end_sec": 504,
      "text": "他在埃德蒙顿公开说"
    },
    {
      "start_sec": 504,
      "end_sec": 505,
      "text": "投票反对加拿大"
    },
    {
      "start_sec": 505,
      "end_sec": 507,
      "text": "是一场危险的虚张声势"
    },
    {
      "start_sec": 507,
      "end_sec": 510,
      "text": "后面会是好几年的不确定"
    },
    {
      "start_sec": 510,
      "end_sec": 511,
      "text": "结果出来以后"
    },
    {
      "start_sec": 511,
      "end_sec": 513,
      "text": "卡尼也是第一时间发表了声明"
    },
    {
      "start_sec": 513,
      "end_sec": 515,
      "text": "他说 10月19号"
    },
    {
      "start_sec": 515,
      "end_sec": 518,
      "text": "阿省人做了一个清楚的选择"
    },
    {
      "start_sec": 518,
      "end_sec": 519,
      "text": "他们选择了团结"
    },
    {
      "start_sec": 519,
      "end_sec": 520,
      "text": "选择了一起建设"
    },
    {
      "start_sec": 520,
      "end_sec": 522,
      "text": "选择了相互照应"
    },
    {
      "start_sec": 522,
      "end_sec": 523,
      "text": "最重要的是"
    },
    {
      "start_sec": 523,
      "end_sec": 525,
      "text": "阿省人选择了加拿大"
    },
    {
      "start_sec": 526,
      "end_sec": 528,
      "text": "接着他把话题转到了能源上"
    },
    {
      "start_sec": 528,
      "end_sec": 531,
      "text": "他说加拿大要把全国的"
    },
    {
      "start_sec": 531,
      "end_sec": 533,
      "text": "大项目加快建设"
    },
    {
      "start_sec": 533,
      "end_sec": 535,
      "text": "那么要做一个全球的能源超级大国"
    },
    {
      "start_sec": 535,
      "end_sec": 539,
      "text": "而阿尔伯塔就是这里面的核心"
    },
    {
      "start_sec": 539,
      "end_sec": 540,
      "text": "这句话"
    },
    {
      "start_sec": 540,
      "end_sec": 542,
      "text": "就是说给阿省人听的"
    },
    {
      "start_sec": 542,
      "end_sec": 543,
      "text": "阿省人"
    },
    {
      "start_sec": 543,
      "end_sec": 545,
      "text": "这些年最大的委屈就是觉得"
    },
    {
      "start_sec": 545,
      "end_sec": 547,
      "text": "自己的石油被渥太华卡着"
    },
    {
      "start_sec": 547,
      "end_sec": 550,
      "text": "那么现在总理亲口说阿省是核心"
    },
    {
      "start_sec": 550,
      "end_sec": 552,
      "text": "就是在给阿省人吃一颗定心丸"
    },
    {
      "start_sec": 553,
      "end_sec": 555,
      "text": "我们再来看独立派这边"
    },
    {
      "start_sec": 555,
      "end_sec": 557,
      "text": "没有一个说要放弃的"
    },
    {
      "start_sec": 557,
      "end_sec": 560,
      "text": "阿尔伯塔繁荣计划的拉斯说"
    },
    {
      "start_sec": 560,
      "end_sec": 562,
      "text": "这个运动会一直存在"
    },
    {
      "start_sec": 562,
      "end_sec": 563,
      "text": "哪都不去"
    },
    {
      "start_sec": 563,
      "end_sec": 564,
      "text": "他还放了句狠话"
    },
    {
      "start_sec": 564,
      "end_sec": 566,
      "text": "说只要史密斯还当"
    },
    {
      "start_sec": 566,
      "end_sec": 568,
      "text": "联合保守党的党魁"
    },
    {
      "start_sec": 568,
      "end_sec": 570,
      "text": "阿尔伯塔就永远独立不了"
    },
    {
      "start_sec": 570,
      "end_sec": 571,
      "text": "而另外一个独立派"
    },
    {
      "start_sec": 571,
      "end_sec": 573,
      "text": "组织的威尔逊说"
    },
    {
      "start_sec": 573,
      "end_sec": 574,
      "text": "我觉得我们赢了"
    },
    {
      "start_sec": 574,
      "end_sec": 575,
      "text": "这次公投"
    },
    {
      "start_sec": 575,
      "end_sec": 577,
      "text": "让大家认认真真地"
    },
    {
      "start_sec": 577,
      "end_sec": 578,
      "text": "讨论了独立这件事情"
    },
    {
      "start_sec": 579,
      "end_sec": 581,
      "text": "咱们再说省长史密斯"
    },
    {
      "start_sec": 581,
      "end_sec": 582,
      "text": "这次公投"
    },
    {
      "start_sec": 582,
      "end_sec": 584,
      "text": "最难受的人可能就是她了"
    },
    {
      "start_sec": 584,
      "end_sec": 586,
      "text": "她办这次公投"
    },
    {
      "start_sec": 586,
      "end_sec": 587,
      "text": "本来就是想两头讨好"
    },
    {
      "start_sec": 588,
      "end_sec": 590,
      "text": "对党内的独立派她说"
    },
    {
      "start_sec": 590,
      "end_sec": 592,
      "text": "你看我给了你们一个投票的机会"
    },
    {
      "start_sec": 592,
      "end_sec": 593,
      "text": "投完了"
    },
    {
      "start_sec": 593,
      "end_sec": 594,
      "text": "大家欣然接受"
    },
    {
      "start_sec": 594,
      "end_sec": 595,
      "text": "然后往前走"
    },
    {
      "start_sec": 596,
      "end_sec": 597,
      "text": "而对渥太华"
    },
    {
      "start_sec": 597,
      "end_sec": 598,
      "text": "她想拿着那9道题的"
    },
    {
      "start_sec": 598,
      "end_sec": 601,
      "text": "赞成票去跟卡尼谈条件"
    },
    {
      "start_sec": 601,
      "end_sec": 603,
      "text": "但是结果怎么样"
    },
    {
      "start_sec": 603,
      "end_sec": 604,
      "text": "两头都没有捞着好"
    },
    {
      "start_sec": 605,
      "end_sec": 606,
      "text": "渥太华这头"
    },
    {
      "start_sec": 606,
      "end_sec": 608,
      "text": "无论是移民还是修宪的议题"
    },
    {
      "start_sec": 608,
      "end_sec": 611,
      "text": "支持和反对的人都没有拉开差距"
    },
    {
      "start_sec": 611,
      "end_sec": 612,
      "text": "等于是意见非常的分裂"
    },
    {
      "start_sec": 613,
      "end_sec": 614,
      "text": "这样的结果给不了"
    },
    {
      "start_sec": 614,
      "end_sec": 617,
      "text": "史密斯任何强有力的授权"
    },
    {
      "start_sec": 617,
      "end_sec": 620,
      "text": "无论是对于联邦更强硬还是更柔和"
    },
    {
      "start_sec": 620,
      "end_sec": 622,
      "text": "那么两边都很难讨好"
    },
    {
      "start_sec": 622,
      "end_sec": 624,
      "text": "而在独立派这头"
    },
    {
      "start_sec": 624,
      "end_sec": 625,
      "text": "问题就更大了"
    },
    {
      "start_sec": 625,
      "end_sec": 626,
      "text": "他们输了"
    },
    {
      "start_sec": 626,
      "end_sec": 628,
      "text": "可是他们不觉得是输给了加拿大"
    },
    {
      "start_sec": 628,
      "end_sec": 630,
      "text": "他们觉得是输给了史密斯"
    },
    {
      "start_sec": 631,
      "end_sec": 632,
      "text": "拉斯是放了句狠话"
    },
    {
      "start_sec": 632,
      "end_sec": 635,
      "text": "只要史密斯还当联合保守党的党魁"
    },
    {
      "start_sec": 635,
      "end_sec": 637,
      "text": "阿尔伯塔省就永远独立不了"
    },
    {
      "start_sec": 638,
      "end_sec": 639,
      "text": "史密斯自己也说过"
    },
    {
      "start_sec": 639,
      "end_sec": 640,
      "text": "只要是她当省长"
    },
    {
      "start_sec": 640,
      "end_sec": 643,
      "text": "就不会再有第二次的独立公投"
    },
    {
      "start_sec": 643,
      "end_sec": 644,
      "text": "这么一来"
    },
    {
      "start_sec": 644,
      "end_sec": 646,
      "text": "等于是独立派把矛头"
    },
    {
      "start_sec": 646,
      "end_sec": 648,
      "text": "从渥太华转向了史密斯"
    },
    {
      "start_sec": 649,
      "end_sec": 651,
      "text": "按照联合保守党的规则"
    },
    {
      "start_sec": 651,
      "end_sec": 654,
      "text": "只要有22个选区的党部提出来"
    },
    {
      "start_sec": 654,
      "end_sec": 656,
      "text": "就能够要求重新审查党魁"
    },
    {
      "start_sec": 656,
      "end_sec": 658,
      "text": "而这次投票前"
    },
    {
      "start_sec": 658,
      "end_sec": 660,
      "text": "已经有三个选区的党部"
    },
    {
      "start_sec": 660,
      "end_sec": 661,
      "text": "是通过了这样的动议"
    },
    {
      "start_sec": 661,
      "end_sec": 662,
      "text": "说白了"
    },
    {
      "start_sec": 662,
      "end_sec": 664,
      "text": "公投在全省是投完了"
    },
    {
      "start_sec": 664,
      "end_sec": 665,
      "text": "可是独立这场仗"
    },
    {
      "start_sec": 665,
      "end_sec": 668,
      "text": "接下来要在史密斯自己的党内打"
    },
    {
      "start_sec": 669,
      "end_sec": 670,
      "text": "明年就是省选了"
    },
    {
      "start_sec": 670,
      "end_sec": 672,
      "text": "她要是连党内这一头都稳不住"
    },
    {
      "start_sec": 672,
      "end_sec": 674,
      "text": "更不用说去争取中间选民"
    },
    {
      "start_sec": 674,
      "end_sec": 675,
      "text": "甚至我们可以说"
    },
    {
      "start_sec": 675,
      "end_sec": 678,
      "text": "有可能这次公投最大的输家"
    },
    {
      "start_sec": 678,
      "end_sec": 680,
      "text": "并不是阿省的独立派"
    },
    {
      "start_sec": 680,
      "end_sec": 682,
      "text": "而是一直想左右逢源"
    },
    {
      "start_sec": 682,
      "end_sec": 684,
      "text": "但是两边都讨不到好"
    },
    {
      "start_sec": 684,
      "end_sec": 685,
      "text": "的阿省省长史密斯"
    },
    {
      "start_sec": 686,
      "end_sec": 688,
      "text": "最后说说我的看法"
    },
    {
      "start_sec": 688,
      "end_sec": 689,
      "text": "上期我说"
    },
    {
      "start_sec": 689,
      "end_sec": 691,
      "text": "这次公投有点像是一个出气口"
    },
    {
      "start_sec": 691,
      "end_sec": 694,
      "text": "阿省很多人心里的不满是"
    },
    {
      "start_sec": 694,
      "end_sec": 696,
      "text": "几十年来积攒下来的"
    },
    {
      "start_sec": 696,
      "end_sec": 698,
      "text": "而这次独立的口子是打开了"
    },
    {
      "start_sec": 698,
      "end_sec": 699,
      "text": "但是最终"
    },
    {
      "start_sec": 699,
      "end_sec": 701,
      "text": "有3/4的选民选择留下"
    },
    {
      "start_sec": 701,
      "end_sec": 702,
      "text": "这是好事"
    },
    {
      "start_sec": 703,
      "end_sec": 705,
      "text": "可是留下来不等于就满意了"
    },
    {
      "start_sec": 705,
      "end_sec": 707,
      "text": "那对魁北克的老两口"
    },
    {
      "start_sec": 707,
      "end_sec": 709,
      "text": "还有那24%的选民"
    },
    {
      "start_sec": 709,
      "end_sec": 712,
      "text": "都是在给渥太华提了一个醒人心"
    },
    {
      "start_sec": 712,
      "end_sec": 715,
      "text": "不是投一次票就能够稳定下来的"
    },
    {
      "start_sec": 715,
      "end_sec": 716,
      "text": "阿省的人"
    },
    {
      "start_sec": 716,
      "end_sec": 717,
      "text": "要的不是走"
    },
    {
      "start_sec": 717,
      "end_sec": 718,
      "text": "而是公平"
    },
    {
      "start_sec": 718,
      "end_sec": 720,
      "text": "是自己的家事"
    },
    {
      "start_sec": 720,
      "end_sec": 722,
      "text": "自己能够有更大的掌控权"
    },
    {
      "start_sec": 722,
      "end_sec": 723,
      "text": "说到这"
    },
    {
      "start_sec": 723,
      "end_sec": 725,
      "text": "我们还是要提到英国"
    },
    {
      "start_sec": 725,
      "end_sec": 728,
      "text": "上期我讲过2016年的脱欧公投"
    },
    {
      "start_sec": 728,
      "end_sec": 731,
      "text": "其实早在1975年"
    },
    {
      "start_sec": 731,
      "end_sec": 734,
      "text": "英国就搞过一次跟欧洲有关的公投"
    },
    {
      "start_sec": 734,
      "end_sec": 735,
      "text": "那时候"
    },
    {
      "start_sec": 735,
      "end_sec": 736,
      "text": "还没有欧盟"
    },
    {
      "start_sec": 736,
      "end_sec": 737,
      "text": "只有欧洲共同体"
    },
    {
      "start_sec": 737,
      "end_sec": 739,
      "text": "英国是在1973年加入的"
    },
    {
      "start_sec": 739,
      "end_sec": 741,
      "text": "可是刚刚进去了两年"
    },
    {
      "start_sec": 741,
      "end_sec": 743,
      "text": "国内就吵翻了"
    },
    {
      "start_sec": 743,
      "end_sec": 744,
      "text": "很多人想退出"
    },
    {
      "start_sec": 744,
      "end_sec": 746,
      "text": "当时的首相叫做威尔逊"
    },
    {
      "start_sec": 746,
      "end_sec": 747,
      "text": "是压不住了"
    },
    {
      "start_sec": 747,
      "end_sec": 750,
      "text": "干脆把这个问题交给老百姓投票"
    },
    {
      "start_sec": 750,
      "end_sec": 752,
      "text": "英国要不要留在欧洲共同体"
    },
    {
      "start_sec": 753,
      "end_sec": 754,
      "text": "结果那次公投"
    },
    {
      "start_sec": 754,
      "end_sec": 757,
      "text": "是67%的人投了留下"
    },
    {
      "start_sec": 757,
      "end_sec": 758,
      "text": "差不多2:1"
    },
    {
      "start_sec": 758,
      "end_sec": 760,
      "text": "跟这次阿省的结果很像"
    },
    {
      "start_sec": 761,
      "end_sec": 762,
      "text": "当时大家都觉得"
    },
    {
      "start_sec": 762,
      "end_sec": 763,
      "text": "这件事情算是了了"
    },
    {
      "start_sec": 764,
      "end_sec": 766,
      "text": "但是脱欧的情绪并没有消散"
    },
    {
      "start_sec": 766,
      "end_sec": 768,
      "text": "而是一点一点地积攒"
    },
    {
      "start_sec": 768,
      "end_sec": 771,
      "text": "后来欧洲共同体变成了欧盟"
    },
    {
      "start_sec": 771,
      "end_sec": 772,
      "text": "管的事情越来越多"
    },
    {
      "start_sec": 772,
      "end_sec": 774,
      "text": "英国人的不满情绪"
    },
    {
      "start_sec": 774,
      "end_sec": 775,
      "text": "也越攒越多"
    },
    {
      "start_sec": 776,
      "end_sec": 777,
      "text": "41年以后"
    },
    {
      "start_sec": 777,
      "end_sec": 779,
      "text": "英国还是投票彻底"
    },
    {
      "start_sec": 779,
      "end_sec": 781,
      "text": "跟欧盟划清了界限"
    },
    {
      "start_sec": 781,
      "end_sec": 783,
      "text": "今天的阿尔伯塔"
    },
    {
      "start_sec": 783,
      "end_sec": 785,
      "text": "有点像1975年的英国"
    },
    {
      "start_sec": 785,
      "end_sec": 785,
      "text": "这一次"
    },
    {
      "start_sec": 785,
      "end_sec": 788,
      "text": "虽然3/4的人选择留下"
    },
    {
      "start_sec": 788,
      "end_sec": 791,
      "text": "可是另外的那1/4的人并没有服气"
    },
    {
      "start_sec": 791,
      "end_sec": 792,
      "text": "接下来的几年"
    },
    {
      "start_sec": 792,
      "end_sec": 795,
      "text": "渥太华如果还是没能让阿省人满意"
    },
    {
      "start_sec": 795,
      "end_sec": 797,
      "text": "那么今天这1/4"
    },
    {
      "start_sec": 797,
      "end_sec": 799,
      "text": "哪一天变成一半也不奇怪"
    },
    {
      "start_sec": 800,
      "end_sec": 801,
      "text": "今天这一票"
    },
    {
      "start_sec": 801,
      "end_sec": 803,
      "text": "阿省人是投给了加拿大"
    },
    {
      "start_sec": 803,
      "end_sec": 805,
      "text": "可是这份信任能够留多久"
    },
    {
      "start_sec": 805,
      "end_sec": 807,
      "text": "还需要时间的检验"
    },
    {
      "start_sec": 808,
      "end_sec": 808,
      "text": "好了"
    },
    {
      "start_sec": 808,
      "end_sec": 811,
      "text": "感谢您收看本期的大伟探秘加拿大"
    },
    {
      "start_sec": 811,
      "end_sec": 813,
      "text": "我们下期再见"
    }
  ]
}